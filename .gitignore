# ===== Secrets / credentials (NEVER commit) =====
.env
.env.*
!.env.example
*.key

# ===== Python environment & caches =====
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# ===== Raw / bulky data (track only data-processed) =====
data/
data-processed/**/*.tif
data-processed/**/*.tiff

# ===== LaTeX build artifacts =====
paper/*.aux
paper/*.log
paper/*.toc
paper/*.lof
paper/*.lot
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
paper/_minted/
paper/*.minted

# ===== Not tracked =====
references/
archive/
.claude/settings.local.json

# ===== OS =====
.DS_Store
Thumbs.db
