# Copy this file to .env and fill in the values. Never commit .env.

# Azure OpenAI: gpt-4o, gpt-5-chat, gpt-5.2-chat
# Each deployment name must equal the model name used in pipelines/model_clients.py (MODEL_REGISTRY).
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure AI Foundry: Phi-4-multimodal-instruct, Llama-4-Maverick-17B-128E-Instruct-FP8, DeepSeek-V4-Flash
# The endpoint must point at the resource's /models route.
AZURE_FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/models
AZURE_FOUNDRY_KEY=your-azure-foundry-key

# Azure Document Intelligence: OCR engine for Vietnamese documents (--ocr-engine azure_di, model prebuilt-read)
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=your-doc-intelligence-key

# Google AI Studio: optional, only for gemini-* / gemma-* models (not part of the main benchmark)
# Get a key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key
