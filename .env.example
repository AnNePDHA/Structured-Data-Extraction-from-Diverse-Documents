# Google AI Studio API key (Gemini / Gemma models)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key

# Azure OpenAI — gpt-4o, gpt-5-chat, gpt-5.2-chat (same resource & key)
AZURE_OPENAI_ENDPOINT=https://azure-ai-openai-servicess.cognitiveservices.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure AI Foundry — Phi-4-multimodal-instruct, Llama-4-Maverick-17B-128E-Instruct-FP8
# Endpoint must point at the resource's /models route.
AZURE_FOUNDRY_ENDPOINT=https://azure-ai-openai-servicess.services.ai.azure.com/models
AZURE_FOUNDRY_KEY=your-azure-foundry-key

# Azure Document Intelligence — OCR engine (--ocr-engine azure_di)
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://docs-ocr-test01.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=your-doc-intelligence-key
